{% sw_extends '@Storefront/storefront/layout/meta.html.twig' %}

{% block layout_head_javascript_tracking %}
    {{ parent() }}

    {% set gtmId               = config('RcTracking.config.gtmId') %}
    {% set uetEnabled          = config('RcTracking.config.uetEnabled') %}
    {% set uetId               = config('RcTracking.config.uetId') %}
    {% set customCode          = config('RcTracking.config.customCode') %}
    {% set marketingPurposeId  = config('RcTracking.config.cmpMarketingPurposeId') %}

    {# Nur rendern wenn mindestens ein Tracking-Dienst konfiguriert ist #}
    {% if gtmId or (uetEnabled and uetId) or customCode %}
    <script>
    (function () {
        'use strict';

        var trackingLoaded = false;

        function loadTracking() {
            {# Guard: verhindert Doppelausführung bei gleichzeitigen CMP-Events #}
            if (trackingLoaded) {
                return;
            }
            trackingLoaded = true;

            {% if gtmId %}
            {# Google Tag Manager #}
            (function (w, d, s, l, i) {
                w[l] = w[l] || [];
                w[l].push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
                var f = d.getElementsByTagName(s)[0];
                var j = d.createElement(s);
                var dl = l !== 'dataLayer' ? '&l=' + l : '';
                j.async = true;
                j.src = 'https://www.googletagmanager.com/gtm.js?id=' + i + dl;
                f.parentNode.insertBefore(j, f);
            }(window, document, 'script', 'dataLayer', '{{ gtmId|e('js') }}'));
            {% endif %}

            {% if uetEnabled and uetId %}
            {# Microsoft UET #}
            (function (w, d, t, r, u) {
                var f, n, i;
                w[u] = w[u] || [];
                f = function () {
                    var o = { ti: '{{ uetId|e('js') }}' };
                    o.q = w[u];
                    w[u] = new UET(o);
                    w[u].push('pageLoad');
                };
                n = d.createElement(t);
                n.src = r;
                n.async = 1;
                n.onload = n.onreadystatechange = function () {
                    var s = this.readyState;
                    if (s && s !== 'loaded' && s !== 'complete') {
                        return;
                    }
                    f();
                    n.onload = n.onreadystatechange = null;
                };
                i = d.getElementsByTagName(t)[0];
                i.parentNode.insertBefore(n, i);
            }(window, document, 'script', 'https://bat.bing.com/bat.js', 'uetq'));
            {% endif %}

            {% if customCode %}
            {# Custom Code ist Admin-Input (Trust-Boundary = Admin-Zugriff) und muss als JS laufen.
               Neutralisiert ausschließlich </script>, damit ein versehentlich eingefügter
               Close-Tag den Script-Kontext nicht bricht — volles Escape würde das JS zerstören. #}
            {{ customCode|replace({'</script': '<\\/script'})|raw }}
            {% endif %}
        }

        {# Marketing-Consent wird ausschließlich am tatsächlichen Per-Purpose-Flag festgemacht —
           niemals an der bloßen Präsenz einer Consent-Zeichenkette (tcString/consentstring wird
           auch bei Ablehnung gesetzt). Geprüft werden beide belegten Strukturen:
           IAB-TCF liefert purpose.consents[id], consentmanager nativ liefert purposeConsents[code]. #}
        function hasMarketingConsent(consentData) {
            if (!consentData) {
                return false;
            }

            {% if marketingPurposeId %}
            {# IAB TCF v2 (__tcfapi): standardisierter Purpose-Consent #}
            if (consentData.purpose
                && consentData.purpose.consents
                && consentData.purpose.consents['{{ marketingPurposeId|e('js') }}'] === true) {
                return true;
            }

            {# Consentmanager nativ (__cmp): benutzerdefinierter Purpose-Code #}
            if (consentData.purposeConsents
                && consentData.purposeConsents['{{ marketingPurposeId|e('js') }}'] === true) {
                return true;
            }
            {% endif %}

            return false;
        }

        function grantIfConsented(consentData) {
            if (hasMarketingConsent(consentData)) {
                loadTracking();
            }
        }

        {% if not marketingPurposeId %}
        {# Ohne konfigurierte Marketing-Purpose-ID lässt sich kein Consent prüfen.
           Default-Deny (DSGVO): nichts laden, aber den Admin darauf hinweisen. #}
        if (typeof console !== 'undefined') {
            console.warn('[RcTracking] Keine Marketing-Purpose-ID konfiguriert – Tracking wird nicht geladen (Default-Deny, DSGVO)');
        }
        return;
        {% endif %}

        var hasTcf = typeof window.__tcfapi === 'function';
        var hasCmp = typeof window.__cmp === 'function';

        if (!hasTcf && !hasCmp) {
            {# Kein Consentmanager vorhanden – DSGVO verbietet Tracking ohne Consent #}
            if (typeof console !== 'undefined') {
                console.warn('[RcTracking] Kein Consentmanager gefunden – Tracking wird nicht geladen (DSGVO)');
            }
            return;
        }

        {# IAB TCF v2: reagiert auf Nutzerentscheidung und gespeicherten Consent (Wiederkehr) #}
        if (hasTcf) {
            window.__tcfapi('addEventListener', 2, function (tcData, success) {
                if (!success || !tcData) {
                    return;
                }
                var status = tcData.eventStatus;
                if (status !== 'useractioncomplete' && status !== 'tcloaded') {
                    return;
                }
                grantIfConsented(tcData);
            });
        }

        {# Consentmanager nativ: aktueller Stand (auch Wiederkehr) plus künftige Änderungen #}
        if (hasCmp) {
            window.__cmp('getCMPData', null, function (data, success) {
                if (success && data && data.userChoiceExists) {
                    grantIfConsented(data);
                }
            });
            window.__cmp('addEventListener', function (data, success) {
                if (success && data) {
                    grantIfConsented(data);
                }
            }, false);
        }
    }());
    </script>
    {% endif %}
{% endblock %}
